{
  "name": "pos-desktop",
  "version": "0.1.0",
  "description": "Offline-first Electron desktop POS client for pos_next (Frappe/ERPNext)",
  "private": true,
  "main": "main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "electron .",
    "build:renderer": "cd renderer && npm run build",
    "dist": "npm run build:renderer && electron-builder --win"
  },
  "dependencies": {
    "express": "^4.21.0",
    "node-thermal-printer": "^4.6.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
